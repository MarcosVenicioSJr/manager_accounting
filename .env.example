# Copie para .env e ajuste os valores. O arquivo .env não vai para o Git.

# Banco de dados (docker-compose e backend)
DB_NAME=manager_accounting
DB_USERNAME=manager
DB_PASSWORD=manager
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/manager_accounting

# E-mail (Mailpit em desenvolvimento)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@manageraccounting.local
MAIL_FROM_NAME=Backoffice contábil
# Em produção, com um SMTP real: MAIL_USERNAME, MAIL_PASSWORD, MAIL_SMTP_AUTH=true e MAIL_SMTP_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Endereço do front (usado nos links enviados por e-mail)
WEB_BASE_URL=http://localhost:5173

# Backend
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Autenticação (JWT)
# Obrigatório em produção: mínimo de 32 caracteres, aleatório e secreto. Gere com: openssl rand -base64 48
# Em desenvolvimento ("mvn spring-boot:run") o perfil dev já traz um valor local.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=4h
JWT_REFRESH_TOKEN_TTL=8h
# Cookie do refresh token: em produção (HTTPS) mantenha REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict

# Recuperação de senha ("Esqueceu sua senha?")
RECUPERACAO_SENHA_TOKEN_TTL=30m
RECUPERACAO_SENHA_INTERVALO_MINIMO=2m
RECUPERACAO_SENHA_MAX_ENVIOS_POR_HORA=5
